<Page x:Class="Editor.Pages.Library"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Editor.Pages"
      mc:Ignorable="d" 
      xmlns:converters="clr-namespace:Editor.Converters"
      Title="Library">

    <Page.Resources>
        <converters:SizePercentageConverter x:Key="SizePercentageConverter"/>
    </Page.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--
        <TextBlock Text="Welcome to the Library Page!" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Grid.Row="0"/>
        -->

        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Grid.Row="0" Margin="0">
            <ToggleButton Content="All" x:Name="allButton" Click="AllButton_Click"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource SizePercentageConverter}, ConverterParameter='20'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualHeight, Converter={StaticResource SizePercentageConverter}, ConverterParameter='11'}"
            />

            <ToggleButton Content="Favorites" x:Name="favoritesButton"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource SizePercentageConverter}, ConverterParameter='20'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualHeight, Converter={StaticResource SizePercentageConverter}, ConverterParameter='11'}"
            />

            <ToggleButton Content="AddCategory" x:Name="addTabButton"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource SizePercentageConverter}, ConverterParameter='20'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualHeight, Converter={StaticResource SizePercentageConverter}, ConverterParameter='11'}"
            />

            <ToggleButton Content="CreateProject" x:Name="createProjectButton" Click="CreateProjectButton_Click"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource SizePercentageConverter}, ConverterParameter='20'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualHeight, Converter={StaticResource SizePercentageConverter}, ConverterParameter='11'}"
            />

            <ToggleButton Content="ExistingProject" x:Name="existingProjectButton" Click="ExistingProjectButton_Click"
                Width="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualWidth, Converter={StaticResource SizePercentageConverter}, ConverterParameter='20'}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=Page}, Path=ActualHeight, Converter={StaticResource SizePercentageConverter}, ConverterParameter='11'}"
            />

        </StackPanel>

        <Frame x:Name="LibraryFrame"  Grid.Column="1">
        </Frame>

    </Grid>
</Page>
